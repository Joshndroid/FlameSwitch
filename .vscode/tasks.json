{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FlameSwitch: Build and push dev image",
      "type": "process",
      "command": "docker",
      "args": [
        "buildx",
        "build",
        "--platform",
        "linux/amd64",
        "--file",
        "${workspaceFolder}/.docker/Dockerfile",
        "--tag",
        "ghcr.io/joshndroid/flame-switch:dev",
        "--build-arg",
        "APP_VERSION=dev",
        "--push",
        "${workspaceFolder}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
